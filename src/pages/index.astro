---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import ProjectsBento from "../components/ProjectsBento.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
---

<Layout
	title="Ariel Campos | Desarrollador Full Stack"
	description="Desarrollador web en Chile. Ariel Campos crea sitios, sistemas a medida y apps para pymes y startups desde La Ligua, Valparaíso."
>
	<!-- Barra de Navegación -->
	<Navbar />

	<main>
		<!-- Sección Inicio -->
		<Hero />

		<!-- Separador decorativo -->
		<div class="section-divider section-divider--animated" aria-hidden="true"></div>

		<!-- Sección Servicios -->
		<Services />

		<!-- Separador decorativo -->
		<div class="section-divider section-divider--animated" aria-hidden="true"></div>

		<!-- Sección Proyectos -->
		<ProjectsBento />

		<!-- Separador decorativo -->
		<div class="section-divider section-divider--animated" aria-hidden="true"></div>

		<!-- Sección Sobre Mí -->
		<About />

		<!-- Separador decorativo -->
		<div class="section-divider section-divider--animated" aria-hidden="true"></div>

		<!-- Sección Contacto y Footer -->
		<Contact />
	</main>
</Layout>
