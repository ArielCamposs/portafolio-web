---
import { projects } from "../data/projects";
---

<section id="proyectos" class="projects-section">
  <div class="projects-header">
    <h2 class="projects-title">Proyectos</h2>
    <p class="projects-copy">
      Una selección de plataformas, aplicaciones y tiendas desarrolladas para
      resolver necesidades reales. Entrá a cada ficha para ver el problema, el
      stack y el enlace.
    </p>
  </div>

  <div class="projects-grid">
    {
      projects.map((item) => (
        <button
          type="button"
          class="project-card"
          data-project-id={item.id}
          aria-label={`Ver detalle de ${item.title}`}
        >
          <img
            src={item.url}
            alt=""
            width={item.width}
            height={item.height}
            loading="lazy"
          />
          <span class="project-card-overlay" aria-hidden="true"></span>
          <span class="project-card-copy">
            <span class="project-card-category">{item.category}</span>
            <span class="project-card-name">{item.title}</span>
            <span class="project-card-desc">{item.desc}</span>
          </span>
        </button>
      ))
    }
  </div>

  <div
    id="project-modal"
    class="project-modal"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="project-modal-title"
    aria-describedby="project-modal-description"
  >
    <div class="project-modal-panel" data-lenis-prevent>
      <button
        type="button"
        class="project-modal-close"
        data-modal-close
        aria-label="Cerrar vista del proyecto"
      >
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M18 6 6 18M6 6l12 12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>

      <div class="project-modal-media" data-modal-media>
        <img data-modal-image alt="" />
        <div class="project-modal-thumbs" data-modal-thumbs hidden></div>
      </div>

      <div class="project-modal-body">
        <p class="project-modal-category" data-modal-category></p>
        <h3 id="project-modal-title" class="project-modal-title"></h3>

        <div class="project-modal-block">
          <p class="project-modal-label">El problema</p>
          <p id="project-modal-description" class="project-modal-problem"></p>
        </div>

        <div class="project-modal-block">
          <p class="project-modal-label">Tecnologías</p>
          <ul class="project-modal-tech" data-modal-tech></ul>
        </div>

        <a
          class="project-modal-link"
          data-modal-link
          hidden
          target="_blank"
          rel="noreferrer"
        >
          Ver sitio
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <p class="project-modal-nolink" data-modal-nolink hidden>
          Proyecto interno · sin enlace público
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initProjectModal } from "../scripts/project-modal";
  initProjectModal();
</script>

<style>
  .projects-section {
    position: relative;
    width: 100%;
    padding: 4rem 0 6rem;
    background: var(--bg-primary);
    color: var(--text-primary);
  }

  .projects-header {
    max-width: 1440px;
    margin: 0 auto 2.5rem;
    padding: 0 1.25rem;
    text-align: center;
  }

  .projects-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 12vw, 10rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .projects-copy {
    max-width: 42rem;
    margin: 1.25rem auto 0;
    font-family: var(--font-geist);
    font-size: 1.05rem;
    line-height: 1.6;
    opacity: 0.7;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  @media (min-width: 768px) {
    .projects-section {
      padding: 6rem 0 7rem;
    }

    .projects-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1rem;
      padding: 0 2rem;
    }
  }

  .project-card {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--bg-secondary);
    text-align: left;
    color: inherit;
  }

  .project-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .project-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(var(--black-rgb) / 0.88),
      rgb(var(--black-rgb) / 0.2) 45%,
      transparent
    );
    pointer-events: none;
  }

  .project-card-copy {
    pointer-events: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.15rem 1.2rem;
    color: #f5f1ed;
    line-height: normal;
  }

  .project-card-category {
    font-family: var(--font-geist);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .project-card-name {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 3rem);
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .project-card-desc {
    font-family: var(--font-geist);
    font-size: 0.95rem;
    line-height: 1.35;
    opacity: 0.85;
  }

  .project-card:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 4px;
  }

  .project-modal {
    position: fixed;
    inset: 0;
    z-index: 20000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    background: rgb(var(--black-rgb) / 0.9);
    backdrop-filter: blur(4px);
    color: rgb(var(--white-rgb));
  }

  .project-modal[hidden] {
    display: none !important;
  }

  .project-modal-panel {
    width: min(72rem, 100%);
    max-height: 90dvh;
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, auto) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid rgb(var(--white-rgb) / 0.15);
    border-radius: 1rem;
    background: rgb(var(--black-rgb));
  }

  .project-modal-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 20;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgb(var(--white-rgb) / 0.3);
    border-radius: 999px;
    background: rgb(var(--black-rgb));
    color: rgb(var(--white-rgb));
  }

  .project-modal-close:hover {
    background: rgb(var(--white-rgb));
    color: rgb(var(--black-rgb));
  }

  .project-modal-close:focus-visible {
    outline: 2px solid rgb(var(--white-rgb));
    outline-offset: 4px;
  }

  .project-modal-media {
    display: flex;
    min-height: 0;
    flex-direction: column;
    padding: 3.5rem 0.75rem 0.75rem;
    background: rgb(var(--black-rgb));
  }

  .project-modal-media img {
    display: block;
    width: 100%;
    max-height: 28dvh;
    object-fit: contain;
    background: rgb(var(--black-rgb));
  }

  .project-modal-media.is-portrait img {
    max-width: 28rem;
    margin: 0 auto;
  }

  .project-modal-thumbs {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.75rem;
    border-top: 1px solid rgb(var(--white-rgb) / 0.15);
  }

  .project-modal-thumbs[hidden],
  .project-modal-link[hidden],
  .project-modal-nolink[hidden] {
    display: none;
  }

  .project-modal-thumb {
    position: relative;
    width: 6rem;
    height: 4rem;
    flex-shrink: 0;
    overflow: hidden;
    padding: 0;
    border: 1px solid rgb(var(--white-rgb) / 0.2);
    border-radius: 0.5rem;
    opacity: 0.7;
  }

  .project-modal-thumb[aria-current="true"] {
    border-color: rgb(var(--white-rgb));
    opacity: 1;
  }

  .project-modal-thumb img {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
  }

  .project-modal-body {
    min-height: 0;
    overflow-y: auto;
    padding: 1.5rem 3.5rem 1.5rem 1.25rem;
    border-top: 1px solid rgb(var(--white-rgb) / 0.15);
  }

  .project-modal-category {
    margin: 0 0 0.5rem;
    font-family: var(--font-geist);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .project-modal-title {
    margin: 0;
    overflow-wrap: anywhere;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 3.75rem);
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .project-modal-block {
    margin-top: 1.5rem;
  }

  .project-modal-label {
    margin: 0 0 0.5rem;
    font-family: var(--font-geist);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.45;
  }

  .project-modal-problem {
    margin: 0;
    font-family: var(--font-geist);
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.85;
  }

  .project-modal-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-modal-tech li {
    border: 1px solid rgb(var(--white-rgb) / 0.25);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    font-family: var(--font-geist);
    font-size: 0.75rem;
  }

  .project-modal-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 0 1rem;
    border: 1px solid rgb(var(--white-rgb) / 0.3);
    border-radius: 999px;
    font-family: var(--font-geist);
    font-size: 0.875rem;
    font-weight: 700;
    color: rgb(var(--white-rgb));
    text-decoration: none;
  }

  .project-modal-link:hover {
    background: rgb(var(--white-rgb));
    color: rgb(var(--black-rgb));
  }

  .project-modal-nolink {
    margin: 2rem 0 0;
    font-family: var(--font-geist);
    font-size: 0.875rem;
    opacity: 0.55;
  }

  @media (min-width: 640px) {
    .project-modal-media img {
      max-height: 32dvh;
    }

    .project-modal-body {
      padding: 2rem 4rem 2rem 1.75rem;
    }
  }

  @media (min-width: 768px) {
    .project-modal-panel {
      grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
      grid-template-rows: minmax(0, 1fr);
    }

    .project-modal-media img {
      max-height: 90dvh;
    }

    .project-modal-media {
      padding: 0;
    }

    .project-modal-body {
      border-top: 0;
      border-left: 1px solid rgb(var(--white-rgb) / 0.15);
      padding-right: 4rem;
    }
  }
</style>
